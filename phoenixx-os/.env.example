# ---- API ----
PORT=4010
NODE_ENV=development
# The public address of the deployment. WEB_BASE_URL is not cosmetic: it builds
# the client proposal share links (/p/:token) and the team invite links
# (/accept-invite), and it seeds the production CORS allow-list. In production
# set both to the real origin, e.g. https://app.phoenixxedu.com
API_BASE_URL=http://localhost:4010
WEB_BASE_URL=http://localhost:5174

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ---- Database ----
# PostgreSQL. In production (Vercel) this is your Neon / Supabase connection
# string - use the POOLED one (Neon: host contains "-pooler"; Supabase: port 6543).
# Leave it empty for local development: the app then runs PostgreSQL
# in-process (PGlite) and keeps its data in ./data/pglite - nothing to install.
DATABASE_URL=
# PGLITE_DIR=./data/pglite
# Uploaded files and generated PDFs are stored in the database too.

# ---- Deployment (see docs/DEPLOY.md) ----
# Vercel: protects /api/v1/cron/tick, which runs the background jobs. Any long
# random string; the scheduler sends it as "Authorization: Bearer <secret>".
CRON_SECRET=
# `npm start` only: serve the built web app from the API process too.
SERVE_WEB=false
# `npm start` only: fill an empty database with the demo workspace.
SEED_ON_BOOT=false

# ---- AI Task Assistant ----
# Optional. With a key, owners' and managers' voice/typed commands are read by
# Claude (structured JSON, matched against your real employee list). Without
# one, the assistant still works using the built-in rule-based parser.
ANTHROPIC_API_KEY=
# TASK_ASSISTANT_MODEL=claude-opus-5-5

# ---- AI Meeting Intelligence ----
# Analysis of meeting transcripts uses ANTHROPIC_API_KEY (above).
# MEETING_ANALYSIS_MODEL=claude-opus-5-5
# Speech-to-text for uploaded recordings (OpenAI). Without it, only transcript
# uploads (TXT/PDF/DOCX/VTT/SRT) can be processed.
OPENAI_API_KEY=
# gpt-4o-transcribe-diarize labels speakers; whisper-1 gives timestamps only.
# TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
# Or Google Gemini (aistudio.google.com -> Get API key). Unset TRANSCRIBE_PROVIDER = whichever key is
# present, OpenAI first. Use a billing-enabled Gemini key for real meetings: free-tier data may be
# used by Google to improve its products.
# TRANSCRIBE_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_TRANSCRIBE_MODEL=gemini-flash-latest   (or pin one, e.g. gemini-3.8-flash)

# ---- AI Meetings: live video (LiveKit) ----
# From LiveKit Cloud -> your project -> Settings -> Keys. Without these, meetings
# can still be scheduled but the Join button says video is not set up.
# The secret stays on the server; browsers only get 10-minute join tokens.
# LIVEKIT_URL looks like wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# In LiveKit Cloud -> Settings -> Webhooks, add:
#   <API_BASE_URL>/api/v1/livekit/webhook   (signed with the key above)
# It drives live/ended status and attendance.

# ---- AI Meetings: recording storage (AWS S3 or S3-compatible) ----
# LiveKit Egress uploads recordings here; the server reads audio back for the
# transcript, deletes it afterwards, and signs 1-hour links for video playback.
# Keep the bucket private (Block Public Access on). Without these, the host's
# "Start recording" is disabled with a note saying storage is not set up.
RECORDING_S3_BUCKET=
# Region, e.g. ap-south-1
RECORDING_S3_REGION=
RECORDING_S3_ACCESS_KEY_ID=
RECORDING_S3_SECRET_ACCESS_KEY=
# RECORDING_S3_PREFIX=meetings
# For a non-AWS store (Cloudflare R2, MinIO): its endpoint, and path-style if it needs it.
# RECORDING_S3_ENDPOINT=
# RECORDING_S3_FORCE_PATH_STYLE=false

# ---- Notification providers ----
# provider ids: log | meta | gupshup | wati
WHATSAPP_PROVIDER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# provider ids: log | smtp
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@phoenixxit.com
TEAMS_WEBHOOK_URL=
# Browser pop-ups (Web Push). Generate a pair once with:
#   npx web-push generate-vapid-keys
# Keep the private key secret; both are needed for pop-ups to work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@phoenixxedu.com

# ---- Billing ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# ---- Jobs ----
JOBS_ENABLED=true
JOB_TICK_MS=60000
